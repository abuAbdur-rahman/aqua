{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aqua",
  "version": "0.1.0",
  "identifier": "com.abdul.aqua",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aqua",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://localhost:61234 ws://localhost:61234; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:61234"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
