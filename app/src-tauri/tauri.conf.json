{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aqua",
  "version": "0.1.1",
  "identifier": "com.abdul.aqua",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aqua",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://localhost:61234 ws://localhost:61234 https://api.open-meteo.com https://ipapi.co; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:61234"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNzdFQ0MyNzNGOUZGMkYKUldRdi8vbHp3dXgzSUdocnorWXJWbitFdkRvNUwrY1k0VFVobmYxN29MZWVYT3VzY0ZPVzVvN08K",
      "endpoints": [
        "https://github.com/abuAbdur-rahman/aqua/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
